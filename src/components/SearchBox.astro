---
export interface Props {
  placeholder?: string;
  compact?: boolean;
}

const {
  placeholder = '输入关键词搜索：如 光速云、IEPL、Clash Verge、节点超时、不限时套餐...',
  compact = false,
} = Astro.props;
---

<div class="w-full" data-search-widget>
  <form action="/search/" method="get" class="relative flex items-center">
    <svg
      class="w-5 h-5 text-[#64748B] absolute left-4 pointer-events-none"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
    </svg>
    <input
      type="search"
      name="q"
      placeholder={placeholder}
      aria-label="搜索全站文章与品牌数据库"
      class:list={[
        'w-full pl-11 pr-28 rounded-2xl bg-white border border-[#E5EAF1] focus:border-[#2563EB] text-[#172033] placeholder:text-[#64748B] shadow-sm transition-colors',
        compact ? 'py-2.5 text-sm' : 'py-3.5 text-base',
      ]}
    />
    <button
      type="submit"
      class:list={[
        'absolute right-2 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-semibold transition-colors cursor-pointer',
        compact ? 'px-3.5 py-1.5 text-xs' : 'px-5 py-2 text-sm',
      ]}
    >
      全文检索
    </button>
  </form>
</div>
