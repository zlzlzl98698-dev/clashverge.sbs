---
import { siteConfig } from '../data/site';

export interface BreadcrumbItem {
  name: string;
  href: string;
}

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  pubDate?: string;
  updatedDate?: string;
  author?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  faq?: { q: string; a: string }[];
  schemaType?: 'WebPage' | 'Article' | 'BlogPosting' | 'ItemList' | 'SoftwareApplication' | 'CollectionPage';
  itemListElements?: { name: string; url: string; position?: number }[];
  softwareApp?: {
    name: string;
    operatingSystem: string;
    applicationCategory: string;
    price?: string;
  };
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  canonical,
  ogType = 'website',
  ogImage = '/images/covers/editorial-network.svg',
  pubDate,
  updatedDate = siteConfig.updatedDate,
  author = siteConfig.author.name,
  noindex = false,
  breadcrumbs = [],
  faq = [],
  schemaType = 'WebPage',
  itemListElements = [],
  softwareApp,
} = Astro.props;

const siteBase = (Astro.site?.toString() || siteConfig.url).replace(/\/$/, '');
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = canonical
  ? canonical.startsWith('http')
    ? canonical
    : `${siteBase}${canonical.startsWith('/') ? canonical : `/${canonical}`}`
  : `${siteBase}${currentPath === '//' ? '/' : currentPath}`;

const fullTitle = title.includes(siteConfig.name) ? title : `${title} | ${siteConfig.name}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteBase}${ogImage}`;

const graph: Record<string, any>[] = [
  {
    '@type': 'Organization',
    '@id': `${siteBase}/#organization`,
    name: siteConfig.name,
    alternateName: siteConfig.englishName,
    url: `${siteBase}/`,
    logo: {
      '@type': 'ImageObject',
      url: `${siteBase}/avatar.webp`,
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${siteBase}/#website`,
    url: `${siteBase}/`,
    name: siteConfig.name,
    inLanguage: siteConfig.language,
    publisher: { '@id': `${siteBase}/#organization` },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteBase}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];

if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.name,
      item: b.href.startsWith('http') ? b.href : `${siteBase}${b.href}`,
    })),
  });
}

if (schemaType === 'Article' || schemaType === 'BlogPosting' || ogType === 'article') {
  graph.push({
    '@type': schemaType === 'BlogPosting' ? 'BlogPosting' : 'Article',
    '@id': `${canonicalUrl}#article`,
    headline: title,
    description,
    image: [fullOgImage],
    datePublished: pubDate || updatedDate,
    dateModified: updatedDate,
    inLanguage: siteConfig.language,
    author: {
      '@type': 'Organization',
      name: author,
    },
    publisher: { '@id': `${siteBase}/#organization` },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
  });
}

if (itemListElements.length > 0) {
  graph.push({
    '@type': 'ItemList',
    name: title,
    numberOfItems: itemListElements.length,
    itemListElement: itemListElements.map((item, idx) => ({
      '@type': 'ListItem',
      position: item.position || idx + 1,
      name: item.name,
      url: item.url.startsWith('http') ? item.url : `${siteBase}${item.url}`,
    })),
  });
}

if (softwareApp) {
  graph.push({
    '@type': 'SoftwareApplication',
    name: softwareApp.name,
    operatingSystem: softwareApp.operatingSystem,
    applicationCategory: softwareApp.applicationCategory,
    offers: {
      '@type': 'Offer',
      price: softwareApp.price || '0',
      priceCurrency: 'CNY',
    },
  });
}

if (faq && faq.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="zh-CN" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="icon" type="image/webp" href="/avatar.webp?v=2" />
<link rel="apple-touch-icon" href="/avatar.webp?v=2" />
<link rel="shortcut icon" href="/favicon.svg?v=2" />
<link rel="sitemap" href="/sitemap-index.xml" />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}

<!-- Open Graph -->
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={fullOgImage} />
{pubDate && <meta property="article:published_time" content={pubDate} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate} />}

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />

<!-- Search Engine Webmaster Verifications (Direct HTML Render) -->
{siteConfig.verification.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
{siteConfig.verification.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
{siteConfig.verification.shenma && <meta name="shenma-site-verification" content={siteConfig.verification.shenma} />}
{siteConfig.verification.baidu && <meta name="baidu-site-verification" content={siteConfig.verification.baidu} />}

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
