---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings?: HeadingItem[];
}

const { headings = [] } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <div class="toc-wrapper">
    <!-- Mobile Collapsible TOC -->
    <details class="lg:hidden mb-6 rounded-2xl border border-[#E5EAF1] bg-[#F7F9FC] p-4">
      <summary class="font-bold text-sm text-[#172033] cursor-pointer flex items-center justify-between">
        <span>📑 本文阅读目录（共 {filteredHeadings.length} 节）</span>
        <span class="text-xs text-[#2563EB]">点击展开</span>
      </summary>
      <ul class="mt-3 pt-3 border-t border-[#E5EAF1] space-y-2 text-sm">
        {filteredHeadings.map((h) => (
          <li class={h.depth === 3 ? 'pl-4 text-xs text-[#64748B]' : 'font-medium text-[#172033]'}>
            <a href={`#${h.slug}`} class="hover:text-[#2563EB] block py-0.5">
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </details>

    <!-- Desktop Sticky TOC -->
    <nav aria-label="文章目录" class="hidden lg:block p-5 rounded-2xl border border-[#E5EAF1] bg-[#F7F9FC]">
      <h2 class="text-xs font-extrabold uppercase tracking-wider text-[#172033] mb-3 pb-2 border-b border-[#E5EAF1]">
        📑 阅读目录导航
      </h2>
      <ul class="space-y-2 text-sm max-h-[60vh] overflow-y-auto pr-1">
        {filteredHeadings.map((h) => (
          <li class={h.depth === 3 ? 'pl-3.5 text-xs text-[#64748B]' : 'font-medium text-[#172033]'}>
            <a
              href={`#${h.slug}`}
              class="hover:text-[#2563EB] transition-colors block leading-snug py-0.5"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}
