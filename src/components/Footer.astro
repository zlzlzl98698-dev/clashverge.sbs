---
import { primaryNavSections } from '../data/navigation';
import { siteConfig } from '../data/site';
import { getTopTenBrands } from '../data/brands';

const topBrands = getTopTenBrands();
---

<footer class="bg-[#F7F9FC] border-t border-[#E5EAF1] mt-20 text-[#172033]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <!-- Top Grid: Brand Intro + 4 Primary Nav Columns + Brand Database Column -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 pb-12 border-b border-[#E5EAF1]">
      <!-- Col 1-2: Site Brand & Disclosure -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5">
          <img
            src="/avatar.webp"
            alt={siteConfig.name}
            class="w-8 h-8 rounded-lg object-cover border border-[#E5EAF1]"
          />
          <span class="text-lg font-extrabold text-[#172033]">{siteConfig.name}</span>
          <span class="text-xs font-mono text-[#2563EB] bg-[#EFF6FF] px-2 py-0.5 rounded">
            {siteConfig.domain}
          </span>
        </a>
        <p class="text-sm text-[#64748B] leading-relaxed">
          {siteConfig.defaultDescription}
        </p>
        <div class="p-3.5 rounded-xl bg-white border border-[#E5EAF1] text-xs text-[#64748B] space-y-1.5">
          <p class="font-semibold text-[#172033]">商业推广披露与编辑独立声明</p>
          <p>{siteConfig.affiliateDisclosure}</p>
        </div>
        <div class="flex flex-wrap gap-3 text-xs text-[#64748B]">
          <span>联系邮箱：<a href={`mailto:${siteConfig.author.email}`} class="text-[#2563EB] hover:underline">{siteConfig.author.email}</a></span>
          <span>·</span>
          <span>数据核验批次：{siteConfig.verifiedBatchDate}</span>
        </div>
      </div>

      <!-- 4 Primary Navigation Columns -->
      {primaryNavSections.map((section) => (
        <div class="space-y-3">
          <a href={section.href} class="text-sm font-bold text-[#172033] hover:text-[#2563EB] block">
            {section.name}
          </a>
          <ul class="space-y-2 text-sm text-[#64748B]">
            {section.topics.map((topic) => (
              <li>
                <a href={topic.href} class="hover:text-[#2563EB] transition-colors">
                  {topic.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Middle Row: Brand Database Quick Index -->
    <div class="py-8 border-b border-[#E5EAF1]">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[#64748B]">
          热门评测品牌档案直达（共收录 31 家独立品牌）
        </h3>
        <a href="/brands/" class="text-xs font-semibold text-[#2563EB] hover:underline">
          进入完整品牌数据库筛选 (/brands/) →
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {topBrands.map((b) => (
          <a
            href={`/brands/${b.slug}/`}
            class="px-3 py-1.5 rounded-lg bg-white border border-[#E5EAF1] hover:border-[#2563EB] text-xs font-medium text-[#172033] hover:text-[#2563EB] transition-colors"
          >
            {b.name}
            {b.isPrimarySponsor && <span class="ml-1 text-[10px] text-[#2563EB] font-semibold">[主推]</span>}
          </a>
        ))}
        <a
          href="/articles/"
          class="px-3 py-1.5 rounded-lg bg-[#EFF6FF] text-xs font-semibold text-[#2563EB]"
        >
          全部原创文章库
        </a>
        <a
          href="/reviews/"
          class="px-3 py-1.5 rounded-lg bg-[#EFF6FF] text-xs font-semibold text-[#2563EB]"
        >
          深度评测中心
        </a>
        <a
          href="/comparisons/"
          class="px-3 py-1.5 rounded-lg bg-[#EFF6FF] text-xs font-semibold text-[#2563EB]"
        >
          横向对比矩阵
        </a>
        <a
          href="/guides/"
          class="px-3 py-1.5 rounded-lg bg-[#EFF6FF] text-xs font-semibold text-[#2563EB]"
        >
          客户端教程库
        </a>
      </div>
    </div>

    <!-- Bottom Legal & Sitemap Row -->
    <div class="pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-[#64748B]">
      <div class="flex flex-wrap items-center gap-4">
        <a href="/about/" class="hover:text-[#2563EB]">关于我们与评测标准</a>
        <a href="/privacy/" class="hover:text-[#2563EB]">隐私政策</a>
        <a href="/disclaimer/" class="hover:text-[#2563EB]">使用声明与合规披露</a>
        <a href="/search/" class="hover:text-[#2563EB]">站内搜索</a>
        <a href="/sitemap-index.xml" class="hover:text-[#2563EB]">Sitemap XML</a>
        <a href="/robots.txt" class="hover:text-[#2563EB]">Robots.txt</a>
      </div>
      <div class="flex items-center gap-4">
        <span>© 2026 {siteConfig.name} ({siteConfig.domain}). 保留所有权利.</span>
        <a
          href="#top"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-white border border-[#E5EAF1] text-[#172033] hover:text-[#2563EB]"
        >
          <span>返回顶部 ↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
