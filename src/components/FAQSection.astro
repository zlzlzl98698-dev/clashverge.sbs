---
export interface Props {
  title?: string;
  subtitle?: string;
  items: { q: string; a: string }[];
}

const {
  title = '常见问题解答 (FAQ)',
  subtitle = '基于真实核验资料与实操经验整理，直接回答高频搜索疑问。',
  items = [],
} = Astro.props;
---

{items.length > 0 && (
  <section class="my-10 bg-[#F7F9FC] border border-[#E5EAF1] rounded-2xl p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl font-extrabold text-[#172033]">{title}</h2>
      <p class="text-sm text-[#64748B] mt-1">{subtitle}</p>
    </div>
    <div class="space-y-3">
      {items.map((item, index) => (
        <details class="group bg-white border border-[#E5EAF1] rounded-xl p-4 sm:p-5" open={index === 0}>
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-bold text-[#172033] text-base">
            <span class="flex items-start gap-2.5">
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] mt-0.5 shrink-0">
                Q{index + 1}
              </span>
              <span>{item.q}</span>
            </span>
            <svg
              class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-3 pt-3 border-t border-slate-100 text-sm sm:text-[15px] text-[#64748B] leading-relaxed">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
