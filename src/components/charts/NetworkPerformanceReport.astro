---
import type { BrandProfile } from '../../data/brands/schema';

export interface Props {
  brand: BrandProfile;
}

const { brand } = Astro.props;
const { speedTest } = brand;

function parseMbps(val: string): number {
  const m = val.match(/(\d+(\.\d+)?)/);
  return m ? Math.min(100, Math.round((parseFloat(m[1]) / 600) * 100)) : 0;
}

const statusMap = {
  operational: { label: 'OPERATIONAL', dot: 'bg-emerald-400', text: 'text-emerald-400', bar: 'bg-emerald-500' },
  stable: { label: 'STABLE', dot: 'bg-sky-400', text: 'text-sky-400', bar: 'bg-sky-500' },
  partial: { label: 'PARTIAL / LOW BW', dot: 'bg-amber-400', text: 'text-amber-400', bar: 'bg-amber-500' },
  untested: { label: 'NOT TESTED', dot: 'bg-slate-500', text: 'text-slate-400', bar: 'bg-slate-600' },
};
---

<section class="observatory-panel p-5 sm:p-6 my-8 shadow-lg" aria-label={`${brand.name} 网络性能可观测性报告`}>
  <!-- Console Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-5 border-b border-[#1E2D4A]">
    <div class="flex items-center gap-3">
      <span
        class="w-3 h-3 rounded-full shrink-0"
        style={`background-color: ${brand.accentColor}; box-shadow: 0 0 10px ${brand.accentColor};`}
      ></span>
      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-base sm:text-lg font-bold text-white tracking-tight">
            {brand.name} · Network Performance Report
          </h3>
          <span class="text-[11px] font-mono-metric px-2 py-0.5 rounded bg-[#111C33] border border-[#1E2D4A] text-sky-300">
            {speedTest.hasMeasuredData ? 'MEASURED DATA' : 'PENDING / VENDOR RECORD'}
          </span>
        </div>
        <p class="text-xs text-slate-400 font-mono-metric mt-0.5">
          TEST DATE: {speedTest.testDate} | ENV: {speedTest.testEnv}
        </p>
      </div>
    </div>

    <div class="text-right font-mono-metric text-xs text-slate-400">
      <span>LINE: {brand.lineCategory}</span>
      <span class="mx-1.5 text-slate-600">|</span>
      <span>PROTO: {brand.protocols.join('/')}</span>
    </div>
  </div>

  <!-- Nodes Performance Bars or Pending Notice -->
  {speedTest.hasMeasuredData && speedTest.nodes.length > 0 ? (
    <div class="space-y-3.5">
      {speedTest.nodes.map((node) => {
        const st = statusMap[node.status] || statusMap.untested;
        const pct = parseMbps(node.download);
        return (
          <div class="observatory-subpanel p-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2 text-xs font-mono-metric">
              <div class="flex items-center gap-2">
                <span class={`w-2 h-2 rounded-full ${st.dot}`}></span>
                <span class="text-white font-bold text-sm">{node.region} 节点</span>
                <span class={`text-[10px] px-1.5 py-0.5 rounded bg-slate-900/80 ${st.text}`}>
                  {st.label}
                </span>
              </div>
              <div class="flex items-center gap-4">
                <span class="text-slate-300">
                  RTT 延迟: <strong class="text-white">{node.latency}</strong>
                </span>
                <span class="text-slate-300">
                  下行吞吐: <strong class="text-emerald-400">{node.download}</strong>
                </span>
                <span class="text-slate-400 hidden sm:inline">
                  丢包率: {node.packetLoss || '未记录'}
                </span>
              </div>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-900 overflow-hidden">
              <div
                class={`h-full rounded-full ${st.bar}`}
                style={`width: ${Math.max(8, pct)}%`}
              ></div>
            </div>
          </div>
        );
      })}
    </div>
  ) : (
    <div class="observatory-subpanel p-5 text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/80 border border-slate-700 text-xs font-mono-metric text-amber-300">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span>STATUS: NOT TESTED / AWAITING VERIFIED SPEED TABLE</span>
      </div>
      <p class="text-sm text-slate-300 max-w-2xl mx-auto">
        {speedTest.summaryNote} 本站严格遵循网络实验室真实性规范，绝不将未实测的演示数值冒充为该品牌的真实测速结果。
      </p>
    </div>
  )}

  <!-- Accessible HTML Text Summary for Search Engines & Screen Readers -->
  <div class="mt-4 pt-3.5 border-t border-[#1E2D4A] flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-slate-400">
    <p>
      <strong class="text-slate-200">实测文字说明：</strong>
      {speedTest.summaryNote}（数据来源：{brand.sourceDoc}）
    </p>
    <span class="font-mono-metric text-[11px] text-slate-500 shrink-0">[clashverge.sbs Observatory]</span>
  </div>
</section>
