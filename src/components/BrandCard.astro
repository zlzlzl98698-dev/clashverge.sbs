---
import type { BrandProfile } from '../data/brands/schema';
import { getBrandLink } from '../data/links';

export interface Props {
  brand: BrandProfile;
  showRegisterButton?: boolean;
  compact?: boolean;
}

const { brand, showRegisterButton = true, compact = false } = Astro.props;
const linkInfo = getBrandLink(brand.slug);
const hkNode = brand.speedTest.nodes.find((n) => n.region.includes('香港'));

const statusBadgeMap: Record<string, { bg: string; text: string; label: string }> = {
  measured: { bg: 'bg-emerald-50 border-emerald-200', text: 'text-emerald-700', label: '实测数据 (Measured)' },
  vendor: { bg: 'bg-sky-50 border-sky-200', text: 'text-sky-700', label: '品牌资料 (Vendor Data)' },
  historical: { bg: 'bg-amber-50 border-amber-200', text: 'text-amber-700', label: '历史记录 (2026-08)' },
  pending: { bg: 'bg-slate-100 border-slate-300', text: 'text-slate-600', label: '待核实 (Pending)' },
};

const badge = statusBadgeMap[brand.dataStatus] || statusBadgeMap.pending;
---

<article
  class="editorial-card p-5 flex flex-col justify-between relative overflow-hidden"
  data-brand-card
  data-name={brand.name.toLowerCase()}
  data-slug={brand.slug}
  data-line={brand.lineCategory}
  data-client={brand.clientSupport}
  data-price={brand.entryMonthlyNumeric}
  data-traffic={brand.baseTrafficGB}
  data-status={brand.dataStatus}
  data-ai={brand.unlockMatrix.chatgpt}
  data-streaming={brand.unlockMatrix.netflix}
>
  {brand.isPrimarySponsor && (
    <div class="mb-3 -mx-5 -mt-5 px-5 py-1.5 bg-[#EFF6FF] border-b border-blue-200 flex items-center justify-between text-xs">
      <span class="font-bold text-[#2563EB]">★ 本站优先推荐品牌（含商业推广合作）</span>
      <span class="text-[#64748B]">2020年老牌 · IEPL双线路</span>
    </div>
  )}

  <div class="space-y-3.5">
    <!-- Top Row: Logo + Name + Verification Badge -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        {brand.logo ? (
          <img
            src={brand.logo}
            alt={`${brand.name} 品牌图标`}
            width="44"
            height="44"
            loading="lazy"
            class="w-11 h-11 rounded-xl object-cover border border-[#E5EAF1] bg-slate-50 shrink-0"
          />
        ) : (
          <div
            class="w-11 h-11 rounded-xl flex items-center justify-center text-white font-bold text-base shrink-0"
            style={`background-color: ${brand.accentColor}`}
          >
            {brand.name.slice(0, 2)}
          </div>
        )}
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-lg font-extrabold text-[#172033] hover:text-[#2563EB] transition-colors">
              <a href={`/brands/${brand.slug}/`}>{brand.name}</a>
            </h3>
            <span class="text-xs text-[#64748B] font-mono">#{brand.rankOrder}</span>
          </div>
          <p class="text-xs text-[#64748B]">{brand.foundedYear}年运营 · {brand.positioning.split('/')[0]}</p>
        </div>
      </div>

      <span class={`text-[11px] font-semibold px-2.5 py-0.5 rounded-full border shrink-0 ${badge.bg} ${badge.text}`}>
        {badge.label}
      </span>
    </div>

    <!-- Price & Key Specs Grid -->
    <div class="grid grid-cols-2 gap-2 p-3 rounded-xl bg-[#F7F9FC] border border-[#E5EAF1] text-xs">
      <div>
        <span class="text-[#64748B] block">入门参考价</span>
        <strong class="text-sm font-bold text-[#172033]">{brand.entryPriceLabel}</strong>
        {brand.isAnnualConvertedPrice && (
          <span class="block text-[10px] text-amber-700">注：含年付折算月均价</span>
        )}
      </div>
      <div>
        <span class="text-[#64748B] block">线路与协议</span>
        <strong class="text-sm font-bold text-[#172033]">{brand.lineCategory}</strong>
        <span class="block text-[11px] text-[#64748B] truncate">{brand.protocols.join(' / ')}</span>
      </div>
      <div>
        <span class="text-[#64748B] block">客户端方式</span>
        <strong class="text-xs font-semibold text-[#2563EB]">{brand.clientSupport}</strong>
      </div>
      <div>
        <span class="text-[#64748B] block">香港非晚高峰测速</span>
        <strong class="text-xs font-mono font-semibold text-[#172033]">
          {hkNode ? `${hkNode.latency} / ${hkNode.download}` : '待核实 / 未实测'}
        </strong>
      </div>
    </div>

    {!compact && (
      <p class="text-sm text-[#64748B] line-clamp-2 leading-relaxed">
        {brand.summary}
      </p>
    )}

    {!compact && linkInfo && linkInfo.couponCode && linkInfo.couponCode !== '待核实' && (
      <div class="flex items-center justify-between px-3 py-1.5 rounded-lg bg-[#EFF6FF] text-xs">
        <span class="text-[#172033]">优惠码：<code class="font-mono font-bold text-[#2563EB]">{linkInfo.couponCode}</code></span>
        <span class="text-[11px] text-[#64748B] truncate max-w-[180px]">{linkInfo.couponNote}</span>
      </div>
    )}
  </div>

  <!-- Card Footer Actions -->
  <div class="pt-4 mt-4 border-t border-slate-100 space-y-2">
    <div class="flex items-center gap-2">
      <a
        href={`/brands/${brand.slug}/`}
        class="flex-1 text-center px-3 py-2 rounded-xl border border-[#E5EAF1] hover:border-[#2563EB] text-xs font-semibold text-[#172033] hover:text-[#2563EB] transition-colors"
      >
        查看评测与套餐档案
      </a>
      {showRegisterButton && linkInfo && (
        <a
          href={linkInfo.registerUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="flex-1 text-center px-3 py-2 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-xs font-semibold text-white transition-colors"
        >
          官网注册入口 ↗
        </a>
      )}
    </div>
    {showRegisterButton && (
      <p class="text-[10px] text-[#64748B] text-center">
        含推广链接，通过链接注册可能为本站带来佣金，不影响用户支付价格
      </p>
    )}
  </div>
</article>
