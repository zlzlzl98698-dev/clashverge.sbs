---
import { primaryNavSections } from '../data/navigation';

const currentPath = Astro.url.pathname;

function isSectionActive(sectionHref: string): boolean {
  return currentPath === sectionHref || currentPath.startsWith(sectionHref);
}
---

<nav aria-label="主导航" class="hidden lg:flex items-center gap-1">
  {primaryNavSections.map((section) => {
    const active = isSectionActive(section.href);
    return (
      <div class="relative group">
        <a
          href={section.href}
          class:list={[
            'inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-[15px] font-semibold transition-colors',
            active
              ? 'bg-[#EFF6FF] text-[#2563EB]'
              : 'text-[#172033] hover:bg-slate-100 hover:text-[#2563EB]',
          ]}
          aria-expanded="false"
        >
          <span>{section.name}</span>
          <svg
            class="w-4 h-4 text-slate-400 group-hover:text-[#2563EB] group-hover:rotate-180 transition-transform duration-150"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Dropdown Mega Card -->
        <div
          class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute left-0 top-full pt-2 w-80 z-50"
        >
          <div class="bg-white border border-[#E5EAF1] rounded-2xl shadow-xl p-3">
            <div class="px-3 py-2 mb-1.5 border-b border-slate-100 flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-[#2563EB]">
                  {section.badge}
                </p>
                <p class="text-xs text-[#64748B] mt-0.5 line-clamp-1">{section.summary}</p>
              </div>
              <a
                href={section.href}
                class="text-xs font-medium text-[#2563EB] hover:underline shrink-0 ml-2"
              >
                频道首页 →
              </a>
            </div>
            <ul class="grid grid-cols-1 gap-0.5">
              {section.topics.map((topic) => {
                const subActive = currentPath === topic.href;
                return (
                  <li>
                    <a
                      href={topic.href}
                      class:list={[
                        'flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-colors',
                        subActive
                          ? 'bg-[#EFF6FF] text-[#2563EB] font-semibold'
                          : 'text-[#172033] hover:bg-[#F7F9FC] hover:text-[#2563EB]',
                      ]}
                    >
                      <span>{topic.name}</span>
                      <span class="text-[11px] text-slate-400">{topic.primaryKeyword}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </div>
    );
  })}
</nav>
