---
import type { BrandProfile } from '../../data/brands/schema';
import { getBrandLink } from '../../data/links';

export interface Props {
  brand: BrandProfile;
}
const { brand } = Astro.props;
const link = getBrandLink(brand.slug);
---

<div class="editorial-card p-5 flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between mb-3">
      <a href={`/brands/${brand.slug}/`} class="text-lg font-extrabold text-[#172033] hover:text-[#2563EB]">
        {brand.name}
      </a>
      <span class="text-xs px-2 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-semibold">
        {brand.lineCategory}
      </span>
    </div>
    <p class="text-xs text-[#64748B] mb-3">{brand.entryPriceLabel}</p>
    <ul class="space-y-2 text-xs border-t border-slate-100 pt-3">
      {brand.plans.slice(0, 4).map((p) => (
        <li class="flex items-center justify-between">
          <span class="text-[#172033] font-medium truncate max-w-[130px]">{p.name}</span>
          <span class="font-mono text-[#2563EB] font-bold">{p.price} ({p.billingCycle})</span>
          <span class="text-[#64748B] font-mono">{p.traffic}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
    <a href={`/brands/${brand.slug}/`} class="text-[#2563EB] font-semibold hover:underline">
      完整套餐与限制 →
    </a>
    {link && (
      <a
        href={link.registerUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="px-2.5 py-1 rounded-lg bg-[#2563EB] text-white font-semibold"
      >
        官网 ↗
      </a>
    )}
  </div>
</div>
