---
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
import { siteConfig } from '../data/site';
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-[#E5EAF1]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <img
        src="/avatar.webp"
        alt={siteConfig.name}
        class="w-9 h-9 rounded-xl object-cover border border-[#E5EAF1] shadow-xs group-hover:scale-105 transition-transform"
      />
      <div>
        <div class="flex items-center gap-1.5">
          <span class="text-lg font-extrabold tracking-tight text-[#172033]">{siteConfig.name}</span>
          <span class="hidden sm:inline-block text-[11px] font-mono px-1.5 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-semibold">
            clashverge.sbs
          </span>
        </div>
        <p class="text-[11px] text-[#64748B] leading-none hidden sm:block">
          中文机场评测 · 品牌数据库 · Clash 知识媒体
        </p>
      </div>
    </a>

    <!-- Strictly 4 Primary Navigation Items -->
    <Navigation />

    <!-- Right Actions: Search + Mobile Menu Button -->
    <div class="flex items-center gap-2">
      <a
        href="/search/"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#F7F9FC] hover:bg-[#EFF6FF] border border-[#E5EAF1] hover:border-blue-200 text-sm text-[#64748B] hover:text-[#2563EB] transition-colors"
        aria-label="站内搜索"
      >
        <svg class="w-4 h-4 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>
        <span class="hidden sm:inline">搜索文章 / 品牌...</span>
        <kbd class="hidden md:inline-block text-[11px] font-mono px-1.5 py-0.5 rounded bg-white border border-slate-200 text-slate-400">
          /
        </kbd>
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center p-2 rounded-xl text-[#172033] hover:bg-slate-100 border border-[#E5EAF1]"
        aria-label="展开导航菜单"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Accordion Menu -->
  <MobileMenu />
</header>
