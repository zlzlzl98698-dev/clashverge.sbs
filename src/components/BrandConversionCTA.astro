---
import { getBrandBySlug } from '../data/brands';
import { getBrandLink } from '../data/links';
import { siteConfig } from '../data/site';

export interface Props {
  brandSlug?: string;
  contextNote?: string;
}

const {
  brandSlug = 'guangsuyun',
  contextNote = '根据本文评测场景，若您需要兼顾自研客户端与 Clash Verge Rev 通用订阅导入，可参考以下核实品牌档案：',
} = Astro.props;

const brand = getBrandBySlug(brandSlug) || getBrandBySlug('guangsuyun')!;
const link = getBrandLink(brand.slug);
---

<aside
  aria-label="相关品牌选型与注册入口"
  class="my-8 p-6 rounded-2xl bg-gradient-to-br from-[#F7F9FC] to-[#EFF6FF]/70 border border-blue-200 shadow-sm"
>
  <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-4 border-b border-blue-100 text-xs">
    <span class="font-bold text-[#2563EB] uppercase tracking-wider">
      专题关联品牌档案 · 透明选型参考
    </span>
    <span class="text-[#64748B]">数据核实批次：{brand.verifiedDate}</span>
  </div>

  <p class="text-xs text-[#64748B] mb-4">{contextNote}</p>

  <div class="flex flex-col md:flex-row md:items-center justify-between gap-5 bg-white p-4 sm:p-5 rounded-xl border border-[#E5EAF1]">
    <div class="space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="text-lg font-extrabold text-[#172033]">{brand.name}</h3>
        <span class="text-xs px-2 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-semibold">
          {brand.lineCategory} · {brand.protocols.join('/')}
        </span>
        <span class="text-xs px-2 py-0.5 rounded bg-slate-100 text-slate-700">
          {brand.clientSupport}
        </span>
      </div>
      <p class="text-sm text-[#64748B] leading-relaxed">{brand.summary}</p>
      <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-[#172033]">
        <span><strong>参考价格：</strong>{brand.entryPriceLabel}</span>
        {link && link.couponCode !== '待核实' && (
          <span><strong>优惠码：</strong><code class="text-[#2563EB] font-bold">{link.couponCode}</code></span>
        )}
      </div>
      <p class="text-[11px] text-amber-800 bg-amber-50 px-2.5 py-1 rounded border border-amber-200">
        购买前必读：{brand.limitations[0]} 建议优先从单月套餐或小额包实测晚高峰表现。
      </p>
    </div>

    <div class="flex flex-col sm:flex-row md:flex-col gap-2.5 shrink-0 md:w-48">
      {link && (
        <a
          href={link.registerUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="text-center px-4 py-2.5 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-sm font-bold transition-colors shadow-sm"
        >
          前往 {brand.name} 官网 ↗
        </a>
      )}
      <a
        href={`/brands/${brand.slug}/`}
        class="text-center px-4 py-2 rounded-xl bg-[#F7F9FC] hover:bg-slate-100 border border-[#E5EAF1] text-xs font-semibold text-[#172033]"
      >
        查看深度评测与限制
      </a>
      <a
        href="/comparisons/"
        class="text-center text-xs text-[#2563EB] hover:underline py-0.5"
      >
        与其他品牌横向对比 →
      </a>
    </div>
  </div>

  <p class="mt-3 text-[11px] text-[#64748B]">
    合规披露：含推广链接，通过链接注册可能为本站带来佣金，不影响用户支付价格。{siteConfig.editorialPolicy}
  </p>
</aside>
