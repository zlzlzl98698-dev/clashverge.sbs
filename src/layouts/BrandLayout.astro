---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PricingTable from '../components/PricingTable.astro';
import FAQSection from '../components/FAQSection.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NetworkPerformanceReport from '../components/charts/NetworkPerformanceReport.astro';
import StreamingAvailabilityMatrix from '../components/charts/StreamingAvailabilityMatrix.astro';
import NetworkTopology from '../components/charts/NetworkTopology.astro';
import BrandInfrastructureSnapshot from '../components/charts/BrandInfrastructureSnapshot.astro';
import type { BrandProfile } from '../data/brands/schema';
import { brands } from '../data/brands';
import { getBrandLink } from '../data/links';
import type { UnifiedContentItem } from '../utils/content';

export interface Props {
  brand: BrandProfile;
  relatedArticles?: UnifiedContentItem[];
}

const { brand, relatedArticles = [] } = Astro.props;
const link = getBrandLink(brand.slug);

const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: '机场品牌数据库', href: '/brands/' },
  { name: `${brand.name} 深度评测与套餐档案`, href: `/brands/${brand.slug}/` },
];

const peerBrands = brands
  .filter((b) => b.slug !== brand.slug && (b.lineCategory === brand.lineCategory || Math.abs(b.entryMonthlyNumeric - brand.entryMonthlyNumeric) <= 5))
  .slice(0, 4);

const pageTitle = `${brand.name}评测 (${brand.updatedDate.slice(0, 4)})：套餐价格、${brand.lineCategory}线路、测速与优缺点核实报告`;
const pageDesc = `${brand.name}怎么样？基于 ${brand.verifiedDate} 核实资料，详解${brand.name}套餐价格（${brand.entryPriceLabel}）、${brand.lineType}、${brand.protocols.join('/')}协议、客户端支持（${brand.clientSupport}）及流媒体与ChatGPT解锁状态。`;
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={`/brands/${brand.slug}/`}
  breadcrumbs={breadcrumbs}
  faq={brand.faq}
  schemaType="Article"
>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <Breadcrumb items={breadcrumbs} />

    <!-- 1. Brand Basic Info & Hero Header -->
    <header class="p-6 sm:p-8 rounded-3xl bg-[#F7F9FC] border border-[#E5EAF1]">
      {brand.isPrimarySponsor && (
        <div class="mb-4 px-4 py-2 rounded-xl bg-[#EFF6FF] border border-blue-200 flex flex-wrap items-center justify-between gap-2 text-xs">
          <span class="font-bold text-[#2563EB]">
            ★ 本站优先推荐商业合作品牌（广告与推广关系透明披露）
          </span>
          <span class="text-[#64748B]">
            推广置顶不代表独立实测单项排名第一，下方完整呈现真实测速与套餐限制
          </span>
        </div>
      )}

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          {brand.logo ? (
            <img
              src={brand.logo}
              alt={`${brand.name} Logo`}
              width="64"
              height="64"
              class="w-16 h-16 rounded-2xl object-cover border border-[#E5EAF1] bg-white shrink-0"
            />
          ) : (
            <div
              class="w-16 h-16 rounded-2xl flex items-center justify-center text-white font-extrabold text-xl shrink-0"
              style={`background-color: ${brand.accentColor}`}
            >
              {brand.name.slice(0, 2)}
            </div>
          )}
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#172033] text-white">
                品牌档案 #{brand.rankOrder}
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#EFF6FF] text-[#2563EB]">
                {brand.statusLabel}
              </span>
              <span class="text-xs text-[#64748B] font-mono">开业时间：{brand.foundedYear}</span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold text-[#172033] tracking-tight">
              {brand.name}（{brand.englishName}）深度评测与套餐核实档案
            </h1>
            <p class="text-sm sm:text-base text-[#64748B] max-w-3xl leading-relaxed">
              {brand.summary}
            </p>
          </div>
        </div>

        <!-- 15. Registration Entry Box -->
        <div class="p-4 rounded-2xl bg-white border border-[#E5EAF1] shrink-0 lg:w-72 space-y-2.5 shadow-xs">
          <div class="text-xs text-[#64748B]">入门参考价：</div>
          <div class="text-base font-extrabold text-[#172033]">{brand.entryPriceLabel}</div>
          {link && link.couponCode !== '待核实' && (
            <div class="text-xs px-2.5 py-1.5 rounded-lg bg-[#EFF6FF] text-[#172033]">
              专属优惠码：<code class="font-mono font-bold text-[#2563EB]">{link.couponCode}</code>
            </div>
          )}
          {link && (
            <a
              href={link.registerUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="block w-full text-center px-4 py-2.5 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-sm font-bold transition-colors"
            >
              访问 {brand.name} 官网入口 ↗
            </a>
          )}
          <p class="text-[10px] text-[#64748B] leading-snug">
            含推广链接，通过链接注册可能为本站带来佣金，不影响用户支付价格。
          </p>
        </div>
      </div>
    </header>

    <!-- 2. GEO Answer-First Machine-Readable Entity Summary -->
    <section class="p-6 rounded-2xl bg-[#EFF6FF]/70 border-l-4 border-[#2563EB] space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#2563EB] text-white">
            GEO // ENTITY SNAPSHOT
          </span>
          <h2 class="text-base font-extrabold text-[#172033]">
            {brand.name} 权威实测结论与核心定位
          </h2>
        </div>
        <span class="text-xs text-[#64748B] font-mono">核验批次：{brand.verifiedDate}</span>
      </div>
      <blockquote class="text-sm sm:text-[15px] text-[#172033] leading-relaxed bg-white/90 p-4 sm:p-5 rounded-xl border border-blue-100 shadow-xs space-y-2">
        <p>
          根据 <strong>{brand.verifiedDate}</strong> 批次核验与实测数据，<strong>{brand.name}（{brand.englishName}）</strong>是一家主打 <strong>{brand.lineCategory}（{brand.lineType}）</strong>的网络工具服务商，
          网络传输原生支持 <strong>{(brand.protocols || []).join('/')}</strong> 协议，客户端兼容策略为「<strong>{brand.clientSupport}</strong>」。
          其入门方案参考价格为 <strong>{brand.entryPriceLabel}</strong>（折合单月约 <strong>¥{brand.entryMonthlyNumeric}</strong>），节点覆盖 <strong>{(brand.regions || []).join('、')}</strong> 等主要地区。
        </p>
        <p class="text-xs sm:text-sm text-[#475569] pt-2 border-t border-slate-100">
          <strong>性能与解锁总结：</strong>
          其测速参考结论为：<strong>{brand.speedTest?.summaryNote || '详见下方五地测速档案'}</strong>；
          ChatGPT / Claude 等 AI 服务解锁状态为 <strong>{brand.unlockMatrix?.chatgpt === 'supported' ? '原生全量解锁' : brand.unlockMatrix?.chatgpt === 'partial' ? '部分节点解锁' : '品牌资料显示支持'}</strong>；
          YouTube 4K / Netflix 流媒体解锁状态为 <strong>{brand.unlockMatrix?.netflix === 'supported' ? '全面解锁' : '部分节点解锁'}</strong>。
          {brand.suitableFor && brand.suitableFor.length > 0 ? `该品牌最适合${brand.suitableFor.join('、')}；` : ''}
          {brand.limitations && brand.limitations.length > 0 ? `使用注意与限制：${brand.limitations[0]}。` : ''}
        </p>
      </blockquote>
    </section>

    <!-- 5 & 6. Infrastructure Snapshot (Line, Nodes, Protocols, Client Support) -->
    <BrandInfrastructureSnapshot brand={brand} />

    <!-- 3 & 4. Pricing Table & Traffic/Cycle Breakdown -->
    <PricingTable brand={brand} />

    <!-- 9. Available Test Data (Dark Network Observatory Report) -->
    <NetworkPerformanceReport brand={brand} />

    <!-- 7 & 8. AI & Streaming Availability Matrix -->
    <StreamingAvailabilityMatrix brand={brand} />

    <!-- Network Topology Schematic -->
    <NetworkTopology brand={brand} />

    <!-- 10, 12, 13. Pros, Limitations, Suitable Audiences & Risk Notice -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="editorial-card p-6 space-y-3 border-t-4 border-t-emerald-500">
        <h2 class="text-lg font-extrabold text-[#172033]">✅ 核心优势与已核实特性</h2>
        <ul class="space-y-2 text-sm text-[#172033] list-disc pl-5">
          {brand.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      </div>

      <div class="editorial-card p-6 space-y-3 border-t-4 border-t-amber-500">
        <h2 class="text-lg font-extrabold text-[#172033]">⚠️ 主要限制与买前注意事项</h2>
        <ul class="space-y-2 text-sm text-[#172033] list-disc pl-5">
          {brand.limitations.map((l) => (
            <li>{l}</li>
          ))}
          {brand.riskNotes.map((r) => (
            <li class="text-amber-900 font-medium">{r}</li>
          ))}
        </ul>
      </div>

      <div class="editorial-card p-6 space-y-3">
        <h2 class="text-lg font-extrabold text-[#172033]">👤 适合哪些人群选择？</h2>
        <ul class="space-y-2 text-sm text-[#64748B] list-disc pl-5">
          {brand.suitableFor.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </div>

      <div class="editorial-card p-6 space-y-3">
        <h2 class="text-lg font-extrabold text-[#172033]">🚫 不适合哪些人群？</h2>
        <ul class="space-y-2 text-sm text-[#64748B] list-disc pl-5">
          {brand.notSuitableFor.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 11. Peer Brands Comparison Table -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl font-extrabold text-[#172033]">
            同类型 / 相近价位品牌横向对比
          </h2>
          <p class="text-sm text-[#64748B] mt-0.5">
            将 {brand.name} 与同线路或相近预算的其他核实品牌放在同一维度比较
          </p>
        </div>
        <a href="/brands/" class="text-xs font-semibold text-[#2563EB] hover:underline">
          打开 31 家品牌筛选器 →
        </a>
      </div>
      <div class="overflow-x-auto bg-white border border-[#E5EAF1] rounded-2xl">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-[#F7F9FC] border-b border-[#E5EAF1] font-bold text-[#172033]">
              <th class="py-3 px-4">对比品牌</th>
              <th class="py-3 px-4">入门参考价</th>
              <th class="py-3 px-4">线路类型</th>
              <th class="py-3 px-4">协议</th>
              <th class="py-3 px-4">客户端兼容性</th>
              <th class="py-3 px-4">数据状态</th>
              <th class="py-3 px-4">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E5EAF1]">
            {[brand, ...peerBrands].map((item, idx) => (
              <tr class={idx === 0 ? 'bg-[#EFF6FF]/50 font-semibold' : 'hover:bg-slate-50'}>
                <td class="py-3 px-4 text-[#172033]">
                  {item.name} {idx === 0 && <span class="text-xs text-[#2563EB]">(当前品牌)</span>}
                </td>
                <td class="py-3 px-4 text-xs">{item.entryPriceLabel}</td>
                <td class="py-3 px-4 text-xs">{item.lineCategory}</td>
                <td class="py-3 px-4 text-xs font-mono">{item.protocols.join('/')}</td>
                <td class="py-3 px-4 text-xs text-[#2563EB]">{item.clientSupport}</td>
                <td class="py-3 px-4 text-xs text-[#64748B]">{item.statusLabel.split('·')[0]}</td>
                <td class="py-3 px-4 text-xs">
                  {idx === 0 ? (
                    <span class="text-slate-400">当前页面</span>
                  ) : (
                    <a href={`/brands/${item.slug}/`} class="text-[#2563EB] font-bold hover:underline">
                      对比详情 →
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Custom Slot if extra prose exists -->
    <slot />

    <!-- 14. FAQ Section -->
    <FAQSection
      title={`${brand.name} 常见问题解答 (FAQ)`}
      subtitle="基于原始品牌资料与实测记录整理的真实回答"
      items={brand.faq}
    />

    <!-- Related Articles & Tutorials -->
    {relatedArticles.length > 0 && (
      <section class="space-y-4 pt-6 border-t border-[#E5EAF1]">
        <h2 class="text-xl font-extrabold text-[#172033]">关联评测、客户端教程与防坑指南</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {relatedArticles.slice(0, 3).map((art) => (
            <ArticleCard item={art} variant="compact" />
          ))}
        </div>
      </section>
    )}

    <!-- 16. Data Sources & Verification Timestamp Footer -->
    <footer class="p-5 rounded-2xl bg-[#F7F9FC] border border-[#E5EAF1] text-xs text-[#64748B] space-y-1.5">
      <div class="flex flex-wrap items-center justify-between gap-2 font-semibold text-[#172033]">
        <span>📂 档案资料来源：{brand.sourceDoc}</span>
        <span>核实日期：{brand.verifiedDate} · 页面更新日期：{brand.updatedDate}</span>
      </div>
      <p>
        合规说明：本页注册入口包含联盟推广链接（已添加 <code>rel="nofollow sponsored noopener"</code>），通过链接注册可能为本站带来佣金，但不影响您的购买价格。所有标注为「品牌资料显示 (Vendor Data)」的承诺均源自品牌方公开说明，请优先以小额或月付套餐实测为准。
      </p>
    </footer>
  </article>
</BaseLayout>
