---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BrandCard from '../components/BrandCard.astro';
import PricingCard from '../components/cards/PricingCard.astro';
import FAQSection from '../components/FAQSection.astro';
import type { SecondaryTopic } from '../data/navigation';
import { getPrimarySectionById } from '../data/navigation';
import type { UnifiedContentItem } from '../utils/content';
import { getBrandBySlug, getMeasuredBrands } from '../data/brands';
import { proxyClients } from '../data/clients';

export interface Props {
  topic: SecondaryTopic;
  articles: UnifiedContentItem[];
}

const { topic, articles } = Astro.props;
const parentSection = getPrimarySectionById(topic.sectionId)!;

const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: parentSection.name, href: parentSection.href },
  { name: topic.name, href: topic.href },
];

const relatedBrands = topic.relatedBrandSlugs
  .map((s) => getBrandBySlug(s))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));

const measuredBrands = getMeasuredBrands();

const topicFaq = topic.clusters.flatMap((c) =>
  c.geoQuestions.map((q) => ({
    q,
    a: `${topic.answerFirstConclusion}（详见本专题下属「${c.title}」及核心关联文章）。`,
  }))
);
---

<BaseLayout
  title={topic.seoTitle}
  description={topic.description}
  canonical={topic.href}
  breadcrumbs={breadcrumbs}
  faq={topicFaq}
  schemaType="CollectionPage"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Topic Header -->
    <header class="p-6 sm:p-9 rounded-3xl bg-[#F7F9FC] border border-[#E5EAF1]">
      <Breadcrumb items={breadcrumbs} />

      <div class="flex flex-wrap items-center gap-2 mb-3">
        <a
          href={parentSection.href}
          class="px-3 py-1 rounded-full text-xs font-bold bg-[#EFF6FF] text-[#2563EB]"
        >
          所属一级栏目：{parentSection.name}
        </a>
        <span class="px-2.5 py-1 rounded-full text-xs font-mono bg-white border border-[#E5EAF1] text-[#172033]">
          主关键词：{topic.primaryKeyword}
        </span>
        <span class="px-2.5 py-1 rounded-full text-xs font-mono bg-slate-100 text-slate-600">
          搜索意图：{topic.searchIntent}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-[#172033] tracking-tight mb-4">
        {topic.title}
      </h1>
      <p class="text-base text-[#64748B] leading-relaxed max-w-4xl mb-6">
        {topic.intro}
      </p>

      <!-- Answer-First Direct Conclusion Box -->
      <div class="p-5 rounded-2xl bg-white border-l-4 border-[#2563EB] shadow-xs">
        <div class="text-xs font-extrabold uppercase tracking-wider text-[#2563EB] mb-1.5">
          ⚡ 专题直接结论 (Answer-First Summary)
        </div>
        <p class="text-sm sm:text-base text-[#172033] font-medium leading-relaxed">
          {topic.answerFirstConclusion}
        </p>
      </div>
    </header>

    <!-- Sibling Topics Navigation Bar -->
    <nav aria-label="同频道二级专题切换" class="flex items-center gap-2 overflow-x-auto pb-2">
      <span class="text-xs font-bold text-[#64748B] shrink-0">同栏目的其他专题：</span>
      {parentSection.topics.map((sib) => (
        <a
          href={sib.href}
          class:list={[
            'px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap border transition-colors',
            sib.slug === topic.slug
              ? 'bg-[#2563EB] text-white border-[#2563EB]'
              : 'bg-white text-[#172033] border-[#E5EAF1] hover:border-[#2563EB]',
          ]}
        >
          {sib.name}
        </a>
      ))}
    </nav>

    <!-- Tertiary Content Clusters (2+ per Secondary Topic) -->
    <section class="space-y-5">
      <div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-[#172033]">
          本专题三级内容集群规划与知识入口
        </h2>
        <p class="text-sm text-[#64748B] mt-1">
          围绕「{topic.primaryKeyword}」拆解的核心搜索问题、GEO 长尾问答与代表性原创文章
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {topic.clusters.map((cluster, idx) => (
          <div class="editorial-card p-6 space-y-4 border-t-4 border-t-[#2563EB]">
            <div class="flex items-center justify-between text-xs">
              <span class="font-mono font-bold text-[#2563EB]">
                CLUSTER 0{idx + 1} // {cluster.id}
              </span>
              <span class="px-2.5 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-semibold">
                目标词：{cluster.targetKeyword}
              </span>
            </div>
            <h3 class="text-lg font-extrabold text-[#172033]">{cluster.title}</h3>
            <p class="text-sm text-[#64748B] leading-relaxed">{cluster.summary}</p>

            <div class="p-3.5 rounded-xl bg-[#F7F9FC] border border-[#E5EAF1] space-y-2 text-xs">
              <p class="font-bold text-[#172033]">🎯 核心解决用户问题：{cluster.userQuestion}</p>
              <div class="space-y-1 text-[#64748B]">
                {cluster.geoQuestions.map((gq) => (
                  <p>• GEO 问答：{gq}</p>
                ))}
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 text-xs">
              <div class="flex flex-wrap gap-1.5">
                {cluster.relatedBrandSlugs.slice(0, 4).map((bs) => {
                  const bObj = getBrandBySlug(bs);
                  return bObj ? (
                    <a
                      href={`/brands/${bObj.slug}/`}
                      class="px-2 py-0.5 rounded bg-slate-100 hover:bg-[#EFF6FF] text-[#172033] hover:text-[#2563EB]"
                    >
                      {bObj.name}
                    </a>
                  ) : null;
                })}
              </div>
              <a
                href={`/articles/${cluster.coreArticleSlug}/`}
                class="font-bold text-[#2563EB] hover:underline"
              >
                阅读集群支柱文章 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Layout Variant Custom Section (Differentiates the 28 Topic Pages!) -->
    {topic.layoutVariant === 'ranking' && (
      <section class="space-y-5">
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#172033]">
            2026-10-19 非晚高峰五地实测速率横向榜单
          </h2>
          <p class="text-sm text-[#64748B] mt-1">
            注：光速云为本站优先商业推广合作方（已标明）；以下表格按客观实测记录并列展示，不篡改任何单项数据。
          </p>
        </div>
        <div class="overflow-x-auto bg-white border border-[#E5EAF1] rounded-2xl shadow-xs">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-[#F7F9FC] border-b border-[#E5EAF1] font-bold text-[#172033]">
                <th class="py-3.5 px-4">品牌名称</th>
                <th class="py-3.5 px-4">线路 / 协议</th>
                <th class="py-3.5 px-4">客户端方式</th>
                <th class="py-3.5 px-4">香港 (延迟/下载)</th>
                <th class="py-3.5 px-4">新加坡 (延迟/下载)</th>
                <th class="py-3.5 px-4">日本 (延迟/下载)</th>
                <th class="py-3.5 px-4">入门价格</th>
                <th class="py-3.5 px-4">评测档案</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#E5EAF1]">
              {measuredBrands.map((b) => {
                const hk = b.speedTest.nodes.find((n) => n.region === '香港');
                const sg = b.speedTest.nodes.find((n) => n.region === '新加坡');
                const jp = b.speedTest.nodes.find((n) => n.region === '日本');
                return (
                  <tr class={b.isPrimarySponsor ? 'bg-[#EFF6FF]/40' : 'hover:bg-slate-50'}>
                    <td class="py-3.5 px-4 font-bold text-[#172033]">
                      <a href={`/brands/${b.slug}/`} class="hover:text-[#2563EB]">{b.name}</a>
                      {b.isPrimarySponsor && (
                        <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-[#2563EB] text-white">商业置顶</span>
                      )}
                    </td>
                    <td class="py-3.5 px-4 text-xs text-[#64748B]">{b.lineCategory} · {b.protocols[0]}</td>
                    <td class="py-3.5 px-4 text-xs font-medium text-[#2563EB]">{b.clientSupport}</td>
                    <td class="py-3.5 px-4 font-mono text-xs">{hk ? `${hk.latency} / ${hk.download}` : '—'}</td>
                    <td class="py-3.5 px-4 font-mono text-xs">{sg ? `${sg.latency} / ${sg.download}` : '—'}</td>
                    <td class="py-3.5 px-4 font-mono text-xs">{jp ? `${jp.latency} / ${jp.download}` : '—'}</td>
                    <td class="py-3.5 px-4 text-xs font-semibold">{b.entryPriceLabel.split('·')[0]}</td>
                    <td class="py-3.5 px-4 text-xs">
                      <a href={`/brands/${b.slug}/`} class="font-bold text-[#2563EB] hover:underline">详情 →</a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {topic.layoutVariant === 'comparison' && (
      <section class="space-y-5">
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#172033]">
            重点品牌套餐档位与计费方式对比卡
          </h2>
          <p class="text-sm text-[#64748B] mt-1">
            直观对比年付小包折算价、单月直付价与一次性不限时流量包
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {relatedBrands.map((b) => (
            <PricingCard brand={b} />
          ))}
        </div>
      </section>
    )}

    {topic.layoutVariant === 'tutorial' && (
      <section class="space-y-5">
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#172033]">
            全平台兼容代理客户端速查矩阵
          </h2>
          <p class="text-sm text-[#64748B] mt-1">
            根据您的操作系统选择仍在积极维护的开源或官方客户端
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {proxyClients.slice(0, 9).map((client) => {
            const clientHref = `/articles/${client.tutorialSlug}/`;
            return (
              <a
                href={clientHref}
                class="editorial-card p-4.5 space-y-2.5 block hover:border-[#2563EB] hover:shadow-md transition-all group cursor-pointer bg-white"
              >
                <div class="flex items-center justify-between">
                  <h3 class="font-bold text-[#172033] group-hover:text-[#2563EB] transition-colors flex items-center gap-1.5">
                    <span>{client.name}</span>
                    <span class="text-xs text-[#2563EB] opacity-0 group-hover:opacity-100 transition-opacity">↗</span>
                  </h3>
                  <span class="text-[11px] px-2 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-semibold shrink-0">
                    {client.pricingModel}
                  </span>
                </div>
                <p class="text-xs text-[#64748B]">{client.os.join(' / ')} · {client.kernel}</p>
                <p class="text-xs text-[#172033] line-clamp-2 leading-relaxed">{client.summary}</p>
                {client.maintenanceNote && (
                  <p class="text-[11px] text-amber-800 bg-amber-50 p-2 rounded border border-amber-200">
                    {client.maintenanceNote}
                  </p>
                )}
                <div class="pt-2 border-t border-[#E5EAF1] flex items-center justify-between text-xs font-semibold text-[#2563EB]">
                  <span>查看选型与配置教程</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Related Brands Grid -->
    {relatedBrands.length > 0 && topic.layoutVariant !== 'comparison' && (
      <section class="space-y-5">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-[#172033]">
              「{topic.name}」关联品牌评测卡片
            </h2>
            <p class="text-sm text-[#64748B] mt-1">点击品牌名称可查阅完整套餐、解锁矩阵与限制说明</p>
          </div>
          <a href="/brands/" class="text-xs font-semibold text-[#2563EB] hover:underline">
            浏览全部 31 家品牌 →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedBrands.map((b) => (
            <BrandCard brand={b} />
          ))}
        </div>
      </section>
    )}

    <!-- Related Articles List (Varying Card Styles by Layout Variant) -->
    <section class="space-y-5">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#172033]">
            专题深度原创文章与实操指南
          </h2>
          <p class="text-sm text-[#64748B] mt-1">拒绝模板化水文，每篇均包含实测数据或完整排障流程</p>
        </div>
        <a href="/articles/" class="text-xs font-semibold text-[#2563EB] hover:underline">
          查看全部文章 →
        </a>
      </div>

      {topic.layoutVariant === 'intelligence' || topic.layoutVariant === 'tutorial' ? (
        <div class="space-y-4">
          {articles.slice(0, 6).map((item) => (
            <ArticleCard item={item} variant="horizontal" />
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {articles.slice(0, 6).map((item) => (
            <ArticleCard item={item} />
          ))}
        </div>
      )}
    </section>

    <!-- Topic FAQ -->
    <FAQSection
      title={`关于「${topic.name}」的常见问答 (GEO Q&A)`}
      subtitle="基于本专题核实资料整理的直接结论"
      items={topicFaq}
    />
  </div>
</BaseLayout>
