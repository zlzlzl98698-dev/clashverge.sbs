---
import BrandLayout from '../../layouts/BrandLayout.astro';
import { brands } from '../../data/brands';
import { getAllPublishedContent } from '../../utils/content';

export function getStaticPaths() {
  return brands.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}

const { brand } = Astro.props;
const allContent = await getAllPublishedContent();
const relatedArticles = allContent.filter(
  (a) =>
    a.data.relatedBrands.includes(brand.slug) ||
    a.data.category === 'airport'
);
---

<BrandLayout brand={brand} relatedArticles={relatedArticles} />
